{
  "info": {
    "name": "Electro Pi - Inventory API",
    "description": "API automation for the Electro Pi inventory endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "inventorySku",
      "value": "MS-001"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}",
              "host": [
                "{{authUrl}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authentication request is successful', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Authentication response contains token', function () {",
                  "    pm.expect(response.token).to.exist;",
                  "});",
                  "",
                  "if (response.token) {",
                  "    pm.environment.set('token', response.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Inventory Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_name\": \"Wireless Mouse\",\n  \"sku\": \"{{inventorySku}}\",\n  \"quantity\": 50,\n  \"price\": 25.00,\n  \"category_id\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "items"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains expected SKU', function () {",
                  "    pm.expect(response.sku).to.eql(pm.variables.get('inventorySku'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}